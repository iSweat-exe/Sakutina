# .env.example file

# Discord Bot
DISCORD_TOKEN=DISCORD_TOKEN
CLIENT_ID=CLIENT_ID
# Comma-separated list of Discord user IDs allowed to use /dev
DEVELOPER_ID=DEVELOPER_ID

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/sakutina

# Environment (development, production)
NODE_ENV=development

# Optional: enables the /ask command
OPENAI_API_KEY=