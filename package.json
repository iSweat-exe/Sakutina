{
  "name": "sakutina",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "cross-env NODE_ENV=production bun src/index.ts",
    "dev": "cross-env NODE_ENV=development bun --watch src/index.ts",
    "deploy": "cross-env NODE_ENV=development bun src/scripts/deploy.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "cross-env": "^10.1.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "i18next": "^26.3.6",
    "postgres": "^3.4.9",
    "winston": "^3.19.0"
  }
}
